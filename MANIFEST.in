# the whole test suite, including its stub server and the guide to what each
# file is for, so a source distribution can actually run and follow the tests
# rather than shipping half of them
recursive-include tests *.py *.md

# the guide to the package's own modules, which setuptools would not
# otherwise carry: only .py files come with a package by default
include hlp_spice2x/README.md

# the version history, which the release notes are drawn from
include CHANGELOG.md

# example profile and the guide to capturing real ones
recursive-include profiles *.json *.md
